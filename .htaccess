Options -Indexes
RewriteEngine On
RewriteBase /PTRP/

<Files "config.php">
  Require all denied
</Files>

RewriteCond %{REQUEST_URI} ^/PTRP/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ api/index.php [QSA,L]
RewriteRule ^manus-storage/(.+)$ api/index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]