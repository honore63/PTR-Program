# Copy to .env and set secrets before starting Docker Compose.
# Generate passwords with a password manager or a cryptographically secure generator.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MANUS_JWT_SECRET=

# Contact form SMTP delivery (Gmail requires an app password when 2-Step Verification is enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PTR Alumni Network

# Optional Manus OAuth and storage configuration
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
OWNER_OPEN_ID=

# Social Media Integration API credentials
# Facebook / Instagram Graph API
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
# YouTube Data API v3
SOCIAL_YOUTUBE_API_KEY=
# TikTok for Business API
SOCIAL_TIKTOK_APP_ID=
SOCIAL_TIKTOK_APP_SECRET=
SOCIAL_TIKTOK_REDIRECT_URI=
# OAuth callback base URL
SOCIAL_OAUTH_CALLBACK_BASE=

# Optional Node / Drizzle scaffold
DATABASE_URL=
SESSION_SECRET=
MANUS_API_BROWSER_KEY=
VITE_API_BASE_URL=
# Vite forwards /PTRP/api/* to this Apache host during local development.
# For production, set to the full API URL (e.g., https://your-domain.com/api).
# When empty, the app uses window.__PTRP_CONFIG__.apiBaseUrl injected by the PHP platform config.
VITE_API_PROXY_TARGET=http://localhost
PORT=3000
NODE_ENV=development
