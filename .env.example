# Copy to .env and set secrets before starting Docker Compose.
# Generate passwords with a password manager or a cryptographically secure generator.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MANUS_JWT_SECRET=

# Optional Manus OAuth and storage configuration
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
OWNER_OPEN_ID=

# Optional Node / Drizzle scaffold
DATABASE_URL=
SESSION_SECRET=
MANUS_API_BROWSER_KEY=
VITE_API_BASE_URL=
PORT=3000
NODE_ENV=development
