{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm install --frozen-lockfile && pnpm exec vite build --base=/",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!assets|manus-storage|resources|partners|favicon|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
